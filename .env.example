# Copy to .env and edit.
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Key the Chrome extension sends (paste it in the extension: Settings -> API server key).
# Leave empty only for single-user local use.
PH_API_KEY=
# Extra key for admin endpoints (/retrain_model, /learning_stats)
PH_ADMIN_KEY=

PH_HOST=127.0.0.1
PH_PORT=5000
# Never enable in production: the debug console allows remote code execution.
PH_DEBUG=0
